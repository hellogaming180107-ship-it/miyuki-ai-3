{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/schema.json",
  "name": "miyuki-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miyuki-memory",
      "database_id": "404b417c-90c6-47d4-b011-1812b5a69288"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
